public class Main
{
    public static boolean palindrome(String s){
        int n=s.length();
        for(int i=1;i<s.length()/2;i++){
            if(s.charAt(i)!=s.charAt(n-i-1))
                return false;
		}
		return true;
    }
	public static void main(String[] args) {
		String s= "racecar";
		System.out.println(palindrome(s));
	}
}
