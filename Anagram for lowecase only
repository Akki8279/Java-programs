public class Main
{
    public static boolean anagram(String s1,String s2){
        int n = s1.length();
        int freq[] = new int[26];
        if(n!=s2.length()) return false; 
        for(int i=0;i<n;i++){
            freq[s1.charAt(i)-'a']++;
            freq[s2.charAt(i)-'a']--;
		}
		for(int f : freq)
		    if(f!=0) return false;
		return true;
    }
	public static void main(String[] args) {
		String s1= "race";
		String s2= "care";
		System.out.println(anagram(s1,s2));
	}
}
